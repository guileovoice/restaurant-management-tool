    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst msg  = body.message || {};\n\nif (msg.type !== 'end-of-call-report') return [];\n\nconst call = msg.call || {};\n\n// ✅ correct structured output location for your payload\nconst soId = \"6286e9ce-e90e-44e2-bf51-9bd5bb175307\";\nlet sd = msg.artifact?.structuredOutputs?.[soId]?.result || {};\nif (sd.result) sd = sd.result;\n\n// Caller number (web calls may not have it)\nconst callerPhone = call.customer?.number || '';\nconst whatsappRaw = sd.whatsappNumber || callerPhone || '';\n\nconst toE164 = (raw) => {\n  if (!raw) return '';\n  const d = String(raw).replace(/\\D/g, '');\n  if (d.length === 10) return '+1' + d;\n  if (d.length === 11 && d.startsWith('1')) return '+' + d;\n  return d ? ('+' + d) : '';\n};\n\nconst callerE164   = toE164(callerPhone);\nconst whatsappE164 = toE164(whatsappRaw);\n\nconst customerName = sd.customerName || 'Guest';\nconst orderType    = (sd.orderType || 'pickup').toLowerCase();\nconst rawItems     = Array.isArray(sd.items) ? sd.items : [];\nconst deliveryAddress = sd.deliveryAddress || '';\n\n// numbers\nconst subtotalRaw = parseFloat(sd.subtotal || 0);\nconst taxRaw      = parseFloat(sd.tax || 0);\nconst totalRaw    = parseFloat(sd.total || 0);\n\n// order id + timestamp\nconst now  = new Date();\nconst ymd  = now.toISOString().slice(0, 10).replace(/-/g, '');\nconst rand = Math.floor(1000 + Math.random() * 9000);\nconst orderId = `NYPDQ-${ymd}-${rand}`;\n\nconst timestamp = now.toLocaleString('en-US', {\n  timeZone: 'America/New_York',\n  dateStyle: 'short',\n  timeStyle: 'short'\n});\n\nconst itemsSheet = rawItems\n  .map(i => `${i.qty || 1}x ${i.name}`)\n  .join(' | ');\n\nconst itemsWA = rawItems\n  .map(i => `• ${i.qty || 1}x ${i.name}`)\n  .join('\\n');\n\nconst orderLine = orderType === 'delivery'\n  ? `Delivery Address: ${deliveryAddress}`\n  : 'Pickup at 3101 31st Ave, Astoria, Queens';\n\nconst paymentLink = `https://pay.guileo.com/order/${orderId}`;\n\nconst whatsappMsg =\n`New York Pao de Queijo\n\nHi ${customerName}!\n\nThanks for calling us.\n\nOrder ID: ${orderId}\n\nItems:\n${itemsWA}\n\n${orderLine}\n\nSubtotal: $${subtotalRaw.toFixed(2)}\nTax: $${taxRaw.toFixed(2)}\nTotal: $${totalRaw.toFixed(2)}\n\nPlease click the secure link below to pay and confirm your order:\n${paymentLink}`;\n\nreturn [{\n  json: {\n    orderId,\n    timestamp,\n    customerName,\n    callerPhone: callerE164,\n    whatsappNumber: whatsappE164,\n    sameNumber: callerE164 === whatsappE164,\n    orderType,\n    itemsSheet,\n    itemsWA,\n    subtotal: '$' + subtotalRaw.toFixed(2),\n    tax: '$' + taxRaw.toFixed(2),\n    total: '$' + totalRaw.toFixed(2),\n    totalRaw,\n    deliveryAddress,\n    status: 'PENDING_CONFIRMATION',\n    whatsappMsg,\n    paymentLink,\n    // useful for debugging\n    structuredOutputRaw: sd\n  }\n}];"
      },
