    {
      "parameters": {
        "jsCode": "const u = $input.first().json;\n\nconst now = new Date();\n\nconst datePart = now\n.toISOString()\n.slice(0,10)\n.replace(/-/g,'');\n\nconst rand =\nMath.floor(1000 + Math.random() * 9000);\n\nconst orderNumber =\n`ORD-${datePart}-${rand}`;\n\n// Convert string items into structured objects\nconst rawItemsText = u.raw_items || '';\n\nconst rawItems = rawItemsText\n.split('|')\n.map(i => i.trim())\n.filter(Boolean)\n.map(i => {\n\nconst qtyMatch = i.match(/^(\\d+)x/);\n\nconst qty = qtyMatch\n  ? parseInt(qtyMatch[1])\n  : 1;\n\nconst name = i\n  .replace(/^(\\d+)x\\s*/, '')\n  .trim();\n\nreturn {\n  name,\n  qty\n};\n\n\n});\n\nconst subtotal =\nparseFloat(u.subtotal || 0);\n\nconst tax =\nparseFloat(u.tax || 0);\n\nconst deliveryFee =\nu.order_type === 'delivery'\n? 10\n: 0;\n\nconst total =\n+(subtotal + tax + deliveryFee)\n.toFixed(2);\n\nconst orderRow = {\n\norder_number: orderNumber,\n\ntenant_id: u.tenant_id,\n\ncustomer_id: u.customer_id,\n\ncustomer_name: u.customer_name,\n\ncustomer_phone:\nu.caller_phone ||\nu.whatsapp_number,\n\nsubtotal,\n\ndelivery_fee: deliveryFee,\n\ntax,\n\ntotal,\n\nstatus: 'PENDING',\n\ntype:\n(u.order_type || 'pickup')\n.toUpperCase(),\n\nchannel: 'VOICE',\n\naddress:\nu.delivery_address || null,\n\norder_items:\nJSON.stringify(rawItems),\n\npayment_status:\nu.payment_status || 'PENDING',\n\norder_place_at:\nu.order_place_at,\n\ncreated_at:\nnow.toISOString(),\n\nupdated_at:\nnow.toISOString()\n};\n\nreturn [{\njson: {\norderRow\n}\n}];\n"
      },
