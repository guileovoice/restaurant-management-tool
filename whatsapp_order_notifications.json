      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v17.0/{{$json[0][\"phone_number_id\"]}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json[0][\"access_token\"]}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{$('Webhook').item.json.body.phone}}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"order_confirmation\",\n    \"language\": {\n      \"code\": \"en_US\"\n    },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": \"{{$('Webhook').item.json.body.customer_name}}\" },\n          { \"type\": \"text\", \"text\": \"{{$('Webhook').item.json.body.order_id}}\" }\n        ]\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "e1f13da4-8b1b-4f51-8395-e2410a56789b",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rvqcajvsnvafzdmdotcw.supabase.co/rest/v1/whatsapp_messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tenant_id\": \"{{$('Webhook').item.json.body.tenant_id}}\",\n  \"phone_number\": \"{{$('Webhook').item.json.body.phone}}\",\n  \"contact_name\": \"{{$('Webhook').item.json.body.customer_name}}\",\n  \"direction\": \"outbound\",\n  \"message_body\": \"Sent order confirmation template.\",\n  \"status\": \"sent\",\n  \"order_id\": \"{{$('Webhook').item.json.body.order_id}}\"\n}",
        "options": {}
      },
      "id": "b78b05d2-f472-46cc-a8b2-5cde7890123c",
