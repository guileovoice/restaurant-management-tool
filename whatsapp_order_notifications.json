    {
      "parameters": {
        "url": "=https://rvqcajvsnvafzdmdotcw.supabase.co/rest/v1/whatsapp_config?tenant_id=eq.{{$json[\"body\"][\"tenant_id\"]}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_ANON_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "c6225ff3-1f14-49c0-9d0a-11234567890a",
