      "id": "2",
      "name": "Get WhatsApp Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [200, 0]
    },
    {
      "parameters": {
        "jsCode": "const order = $('Webhook — Web Order').item.json.body;\n\nlet msg = `Hi ${order.customerName}!\\n\\nThanks for your online order.\\n\\nOrder ID: ${order.orderNumber}\\n\\nItems:\\n`;\n\nif (order.items && Array.isArray(order.items)) {\n  order.items.forEach(item => {\n    msg += `• ${item.quantity}x ${item.name}\\n`;\n  });\n}\n\nmsg += `\\nTotal Paid: $${order.total.toFixed(2)}\\n\\nYour order is now being prepared!`;\n\nreturn { json: { formattedMsg: msg } };"
      },
      "id": "3",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v17.0/{{$('Get WhatsApp Config').item.json[\"phone_number_id\"] || 'dummy_id'}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$('Get WhatsApp Config').item.json[\"access_token\"] || 'dummy_token'}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{$('Webhook — Web Order').item.json.body.customerPhone}}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"order_confirmation_with_payment\",\n    \"language\": {\n      \"code\": \"en_US\"\n    },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": \"{{$('Webhook — Web Order').item.json.body.customerName}}\" },\n          { \"type\": \"text\", \"text\": \"{{$('Webhook — Web Order').item.json.body.orderNumber}}\" },\n          { \"type\": \"text\", \"text\": \"{{$('Webhook — Web Order').item.json.body.paymentLink}}\" }\n        ]\n      }\n    ]\n  }\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
